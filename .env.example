# Application
APP_NAME="British Auction RFQ System"
API_V1_PREFIX=/api/v1
DEBUG=true

# Database (PostgreSQL for Docker, SQLite for lightweight local runs)
# For local SQLite: sqlite:///./british_auction.db
# For PostgreSQL: postgresql+psycopg2://postgres:password123@localhost:5432/british_auction
DATABASE_URL=sqlite:///./british_auction.db

# Redis Broker (for Celery workers)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated if using custom parsing)
# Defaults: http://localhost:3000, http://localhost:5173
